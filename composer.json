{
    "name": "betterbrief/silverstripe-googlemapfield",
    "type": "silverstripe-vendormodule",
    "description": "Save locations using latitude/longitude DataObject fields.",
    "keywords": ["maps","google", "googlemapfield", "silverstripe", "map", "geolocation"],
    "homepage": "http://github.com/BetterBrief/googlemapfield",
    "license": "BSD",
    "authors": [
        {
            "name": "Will Morgan",
            "homepage": "http://twitter.com/willmorgan",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "silverstripe/framework": "^4.0|^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "silverstripe/recipe-testing": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "BetterBrief\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BetterBrief\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        },
        "expose": [
            "client/css",
            "client/js"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
